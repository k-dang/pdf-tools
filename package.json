{
  "name": "pdf-tools",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/bun": "latest",
    "eslint": "^9.21.0",
    "globals": "^15.15.0",
    "prettier": "3.7.4",
    "typescript-eslint": "^8.23.0",
    "typescript": "^5"
  },
  "scripts": {
    "dev:cli": "bun run --filter=@k-dang/pdf-tools dev",
    "dev:web": "bun run --filter=web dev",
    "build:cli": "bun run --filter=@k-dang/pdf-tools build",
    "build:web": "bun run --filter=web build",
    "start:web": "bun run --filter=web start",
    "check": "bun run --filter=@k-dang/pdf-tools check",
    "format": "prettier --write .",
    "lint": "eslint apps/cli packages/utils",
    "lint:cli": "eslint apps/cli",
    "lint:utils": "eslint packages/utils"
  }
}
